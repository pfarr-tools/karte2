#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./karte <command>

Commands:
  up       Start the application
  down     Stop the application
  restart  Restart the application
  build    Build the application image
  install  Build the application image and dependencies
  logs     Follow application logs
  shell    Open a shell in the application container
  migrate  Apply migrations and source registry synchronization
  status   Show database and import status
  import   Import the official ELKW listing page
  geocode  Geocode unresolved locations
  test     Run the isolated test service
EOF
}

command="${1:-help}"
case "$command" in
  up) docker compose -f compose.yaml up -d --build ;;
  down) docker compose -f compose.yaml down ;;
  restart) docker compose -f compose.yaml down && docker compose -f compose.yaml up -d --build ;;
  build) docker compose -f compose.yaml build ;;
  install) docker compose -f compose.yaml build ;;
  logs) docker compose -f compose.yaml logs -f ;;
  shell) docker compose -f compose.yaml run --rm --build app sh ;;
  migrate|status|import|geocode) docker compose -f compose.yaml run --rm --build app node src/cli.js "$@" ;;
  test) docker compose -f compose.yaml -f compose.test.yaml run --rm --build test ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $command" >&2; usage >&2; exit 2 ;;
esac
